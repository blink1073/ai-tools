#!/usr/bin/env bash
# opencode-sandbox — open an opencode session in a per-project sandbox.
#
# With no subcommand, creates the sandbox for the current directory if needed,
# then drops you into opencode inside it. Any arguments are appended to the
# entry command, so opencode flags pass straight through:
#
#   opencode-sandbox --model provider/model --agent plan
#
# Subcommands:
#   opencode-sandbox sessions   print the number of attached sessions (integer)
#   opencode-sandbox down       stop and remove the sandbox for this directory
#
# Tear down with `opencode-sandbox down` (or `podbox rm`). See `podbox` for all
# options (PODBOX_NAME, PODBOX_IMAGE, PODBOX_MODEL, PODBOX_ENTRY, GH_TOKEN_SANDBOX,
# PODBOX_GIT_NAME, PODBOX_GIT_EMAIL).

set -euo pipefail

case "${1:-}" in
  down|rm) exec podbox rm ;;
  sessions|in-use) exec podbox sessions ;;
  *) exec podbox up "$@" ;;
esac
