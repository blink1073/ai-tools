# podbox base image — the Debian base the per-project sandboxes run on.
# Built by `podbox build` (and automatically on the first `podbox create`),
# tagged podbox-base:latest. Baking git/python/gh/opencode here keeps every new
# sandbox from re-running apt-get on startup.
FROM debian:stable-slim

ENV DEBIAN_FRONTEND=noninteractive

# The unprivileged user the sandbox runs as. It has passwordless sudo so the
# agent can still install system packages when a task needs it, but ordinary
# commands (and the agent session itself) run without root.
ARG SANDBOX_USER=dev

# Debian marks the system Python as externally managed (PEP 668), so `pip
# install` refuses to run. This is a disposable sandbox, so allow it.
RUN printf '[global]\nbreak-system-packages = true\n' > /etc/pip.conf

RUN apt-get update \
 && apt-get -y install --no-install-recommends \
      ca-certificates git curl jq unzip xz-utils openssh-client which sudo \
      python3 python3-dev python3-pip python3-venv \
      gcc make \
 && rm -rf /var/lib/apt/lists/*

# Create the unprivileged user and grant it passwordless sudo. The opencode
# config file and agent dir are created up front so the read-only bind-mounts
# in podbox land on a file (not a directory) and a user-owned directory.
RUN set -eux; \
    useradd --create-home --shell /bin/bash --uid 1000 "$SANDBOX_USER"; \
    usermod -aG sudo "$SANDBOX_USER"; \
    printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$SANDBOX_USER" > "/etc/sudoers.d/$SANDBOX_USER"; \
    chmod 0440 "/etc/sudoers.d/$SANDBOX_USER"; \
    install -d -o "$SANDBOX_USER" -g "$SANDBOX_USER" "/home/$SANDBOX_USER/.config/opencode/agent"; \
    install -o "$SANDBOX_USER" -g "$SANDBOX_USER" -m 0644 /dev/null "/home/$SANDBOX_USER/.config/opencode/opencode.json"

# GitHub CLI isn't in Debian's repos; install the official static binary.
ARG GH_VERSION=2.63.2
RUN set -eux; \
    case "$(uname -m)" in \
      x86_64)          gharch=amd64 ;; \
      aarch64|arm64)   gharch=arm64 ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gharch}.tar.gz" -o /tmp/gh.tar.gz; \
    tar -xzf /tmp/gh.tar.gz -C /tmp; \
    install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${gharch}/bin/gh" /usr/local/bin/gh; \
    rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${gharch}"

# just (command runner), from its official installer.
RUN curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh \
      | bash -s -- --to /usr/local/bin --force

# uv (Python project/package manager), from its official installer.
RUN curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

# opencode, installed into the sandbox user's home (so the unprivileged user can
# traverse it) and symlinked onto PATH so non-interactive shells find it too.
RUN set -eux; \
    export HOME="/home/$SANDBOX_USER"; \
    curl -fsSL https://opencode.ai/install | bash; \
    found="$(find "$HOME/.opencode/bin" "$HOME/.local/bin" /usr/local/bin -maxdepth 1 -name opencode -type f 2>/dev/null | head -n1)"; \
    test -n "$found" || { echo "opencode installer produced no binary" >&2; exit 1; }; \
    [ "$found" = /usr/local/bin/opencode ] || ln -sf "$found" /usr/local/bin/opencode; \
    chown -R "$SANDBOX_USER:$SANDBOX_USER" "$HOME/.opencode" "$HOME/.local" 2>/dev/null || true

# Hand the toolchain dirs to the sandbox user so `pip install` and `uv` work
# without sudo. This is a disposable sandbox; the user already has sudo anyway.
RUN set -eux; \
    chown -R "$SANDBOX_USER:$SANDBOX_USER" /usr/local; \
    for d in /usr/lib/python3/dist-packages /usr/lib/python3.*/site-packages; do \
      [ -d "$d" ] && chown -R "$SANDBOX_USER:$SANDBOX_USER" "$d" || true; \
    done
